{
  "name": "turbo-kart-rally",
  "version": "1.0.0",
  "description": "**An arcade kart racer in the spirit of Mario Kart, built entirely with Three.js. Every mesh, texture, sound effect and music track is generated in code at load time. There are no asset files and no build step.**",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "start:8081": "node server/server.js --port 8081",
    "test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridge-mind/turbo-kart-rally.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bridge-mind/turbo-kart-rally/issues"
  },
  "homepage": "https://github.com/bridge-mind/turbo-kart-rally#readme",
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0"
  }
}
